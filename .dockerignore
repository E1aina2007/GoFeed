# All Dockerfiles use the repository root as their build context.

# Repository metadata and documentation
.git
.github
docs
*.md
.gitignore
.gitattributes
docker-compose.yml
Dockerfile
**/.dockerignore
**/.idea
**/.vscode

# Local dependencies, caches, and runtime data
**/node_modules
**/.pnpm-store
**/.run
**/tmp
**/bin
**/*.log
**/*.exe
**/*.out
**/*.test
**/*.tsbuildinfo

# Build and test output
frontend/dist
frontend/dist-ssr
frontend/coverage
frontend/playwright-report
frontend/test-results
frontend/.eslintcache

# Test-only source and Compose-mounted migrations
backend/**/*_test.go
frontend/e2e
frontend/src/**/__tests__
backend/db/migrations

# Local configuration and secrets
**/.env
**/.env.*
backend/configs/config*.yaml
!backend/configs/config.example.yaml

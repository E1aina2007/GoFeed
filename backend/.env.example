# 环境变量示例（本地开发默认值）
# 当前版本支持的配置项均在此列出；环境变量优先于 YAML。
# Docker 部署时请参考 README「Docker 部署」小节：在 backend 目录创建 .env，
# 使用 MODE=prod、MYSQL_HOST=mysql，本文件仅作为变量参考，不放在根目录。

# Application
MODE=dev                       # 仅 MODE=prod 启用生产模式，其他值均按 dev 处理
CONFIG_PATH=configs/config.dev.yaml
SERVER_PORT=8080          # 对应 config.example.yaml 的 server.port

# MySQL
MYSQL_HOST=localhost       # 对应 database.host
MYSQL_PORT=3306            # 对应 database.port
MYSQL_USER=root            # 对应 database.user
MYSQL_ROOT_PASSWORD=your-mysql-password  # 数据库密码（不从 YAML 读取）
# MYSQL_PASSWORD=your-mysql-password      # 非 root 用户使用此变量；root 优先使用上面的变量
MYSQL_DATABASE=feedsystem  # 对应 database.dbname

# Sweeper
RETENTION_USER_DELETED_DAYS=7     # 对应 retention.user_deleted_days
RETENTION_VIDEO_DELETED_DAYS=7    # 对应 retention.video_deleted_days
RETENTION_VIDEO_DRAFT_HOURS=24    # 对应 retention.video_draft_hours
SWEEPER_INTERVAL_MINUTES=60       # 对应 sweeper.interval_minutes
SWEEPER_DRAFT_PURGE_LEASE_MINUTES=15 # 对应 sweeper.draft_purge_lease_minutes

# Authentication
JWT_SECRET=replace-with-a-32-characters-random-secret  # 仅从环境变量读取

# 环境变量示例（本地开发默认值）
# 当前版本支持的配置项均在此列出；环境变量优先于 YAML
# Docker 部署时请参考 README「Docker 部署」小节：在 backend 目录创建 .env，
# 使用 MODE=prod、MYSQL_HOST=mysql，本文件仅作为变量参考，不放在根目录

# Application
MODE=dev                       # 仅 MODE=prod 启用生产模式，其他值均按 dev 处理
CONFIG_PATH=configs/config.dev.yaml
SERVER_PORT=8080          # 对应 config.example.yaml 的 server.port

# MySQL
MYSQL_HOST=localhost       # 对应 database.host
MYSQL_PORT=3306            # 对应 database.port
MYSQL_USER=root            # 对应 database.user
MYSQL_ROOT_PASSWORD=your-mysql-password  # 数据库密码（不从 YAML 读取）
# MYSQL_PASSWORD=your-mysql-password      # 非 root 用户使用此变量；root 优先使用上面的变量
MYSQL_DATABASE=feedsystem  # 对应 database.dbname

# Sweeper
RETENTION_USER_DELETED_DAYS=7     # 对应 retention.user_deleted_days
RETENTION_VIDEO_DELETED_DAYS=7    # 对应 retention.video_deleted_days
RETENTION_VIDEO_DRAFT_HOURS=24    # 对应 retention.video_draft_hours
RETENTION_MEDIA_ORPHAN_HOURS=24   # 对应 retention.media_orphan_hours
SWEEPER_INTERVAL_MINUTES=60       # 对应 sweeper.interval_minutes
SWEEPER_DRAFT_PURGE_LEASE_MINUTES=15 # 对应 sweeper.draft_purge_lease_minutes

# Redis
REDIS_HOST=localhost               # 对应 redis.host；Compose 内由服务名 redis 覆盖
REDIS_PORT=6379                    # 对应 redis.port
REDIS_DB=0                         # 对应 redis.db
REDIS_PASSWORD=replace-with-a-long-random-redis-password  # 仅从环境变量读取

# Feed
FEED_PAGE_CACHE_ENABLED=false      # 默认关闭；开启后仅缓存 /api/feed 的后续页
FEED_CARD_CACHE_ENABLED=false      # 默认关闭；同时开启页缓存时才读取基础卡片缓存
FEED_PUBLISHED_EVENT_ENABLED=false # 默认关闭；worker 处理成功时同事务写入发布事件
FEED_CARD_WARMUP_ENABLED=false     # 默认关闭；worker 消费发布事件并预热卡片，关闭生产者后仍可排空
FEED_HEAT_CONSUMER_ENABLED=false   # 默认关闭；独立消费 feed.heat，不开放 Hot 场景
FEED_HEAT_GENERATION=initial       # 修改规则或重建需使用新代际；本模块不证明覆盖完整
FEED_HEAT_WINDOW_MINUTES=60
FEED_HEAT_RETENTION_GRACE_MINUTES=10
FEED_HEAT_DEDUPE_TTL_HOURS=24
FEED_HEAT_LIKE_WEIGHT=3
FEED_HEAT_COMMENT_WEIGHT=5
FEED_HEAT_MAX_VIDEOS_PER_MINUTE=10000
FEED_HEAT_MAX_EVENTS_PER_MINUTE=100000

# Interaction
INTERACTION_EVENTS_ENABLED=false  # 对应 interaction.events_enabled；应用迁移 000010 后开启同事务事实记录
INTERACTION_RELAY_ENABLED=false   # 对应 interaction.relay_enabled；需同时开启本 worker 热度消费，真实链路验收后启用

# RabbitMQ
RABBITMQ_HOST=localhost            # 对应 rabbitmq.host；Compose 内由服务名 rabbitmq 覆盖
RABBITMQ_PORT=5672                 # 对应 rabbitmq.port
RABBITMQ_DEFAULT_USER=gofeed       # 对应 rabbitmq.username，并初始化 Compose RabbitMQ 用户
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-rabbitmq-password  # 仅从环境变量读取

# Authentication
JWT_SECRET=replace-with-a-32-characters-random-secret  # 仅从环境变量读取

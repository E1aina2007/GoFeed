# 环境变量示例（本地开发默认值）
# 与 configs/config.example.yaml 的字段一一对应，环境变量优先（覆盖 YAML）。
# Docker 部署时请参考 README「Docker 部署」小节：在项目根目录创建 .env，
# 使用 MODE=prod、MYSQL_HOST=mysql，本文件仅作为变量参考，不放在根目录。

# Application
MODE=dev
CONFIG_PATH=configs/config.dev.yaml
SERVER_PORT=8080          # 对应 config.example.yaml 的 server.port

# MySQL
MYSQL_HOST=localhost       # 对应 database.host
MYSQL_PORT=3306            # 对应 database.port
MYSQL_USER=root            # 对应 database.user
MYSQL_ROOT_PASSWORD=your-mysql-password  # 对应 database.password
# Use MYSQL_PASSWORD instead when connecting with a non-root MySQL user.
# MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=feedsystem  # 对应 database.dbname

# Authentication
JWT_SECRET=replace-with-a-32-characters-random-secret
